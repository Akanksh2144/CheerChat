    final List<String> images = host.images ?? [];

    return Scaffold(
      appBar: AppBar(),
      body: SingleChildScrollView(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            /// 🔹 Image Gallery
            SizedBox(
              height: 350,
              child: PageView.builder(
