                            Icons.block,
                            size: 14,
                            color: isMe
                                ? Colors.white70
                                : Colors.grey,
                          ),
                          const SizedBox(width: 5),
                          Text(
                            "This message was deleted",
                            style: TextStyle(
                              fontStyle: FontStyle.italic,
